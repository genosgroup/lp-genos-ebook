# Webhook do n8n que recebe os leads do formulário do popup (ação "Webhook" do Elementor).
# Obrigatório: sem ele o formulário responde com erro em vez de perder o lead.
LEAD_WEBHOOK_URL=

# Para onde o visitante vai depois de enviar o formulário (ação "Redirecionar" do Elementor).
# Aceita os mesmos marcadores do Elementor, ex.:
# CHECKOUT_URL=https://pay.hotmart.com/XXXXXXX?name=[field id="nome"]&email=[field id="email"]
CHECKOUT_URL=
